# Copy to .env and adjust. Read by docker compose, the Spring Boot backend
# (via spring.config.import) and the Vite frontend (envDir = project root).

# --- PostgreSQL ---
POSTGRES_DB=creditrisk
POSTGRES_USER=creditrisk
POSTGRES_PASSWORD=creditrisk
POSTGRES_PORT=5432

# --- Backend ---
DB_URL=jdbc:postgresql://localhost:5432/creditrisk
PORT=8080
# HS256 signing key: at least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Token lifetime in milliseconds (default 24h)
JWT_EXPIRATION_MS=86400000
# Comma-separated list of allowed browser origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080
